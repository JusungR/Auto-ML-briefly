# Python 빌드/캐시 부산물
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 단계 간 중간 산출물 (train/*.py, inference/*.py 의 work_dir)
artifacts/**/work/

# 실행 샘플 (examples/sample/run_sample.py) 이 생성하는 데이터 / 산출물
examples/sample/data/
artifacts/sample/

# 실행 이력 / 배포 이력 (auto_ml.versioning) — 예시 산출물에 학습 이력이 쌓여 커밋되지 않게
artifacts/**/runs/
artifacts/**/deployments.jsonl
