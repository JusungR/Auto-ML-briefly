<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<title>{{ title }}</title>
<style>
  @page { size: A4; margin: 15mm 18mm; }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: "Apple SD Gothic Neo", "Malgun Gothic", "Helvetica Neue", Arial, sans-serif;
    font-size: 12px;
    color: #1e2329;
    line-height: 1.6;
    background: #fff;
  }

  .report-header {
    background: linear-gradient(135deg, #4b5563 0%, #1f2937 100%);
    color: #fff;
    padding: 20px 24px 16px;
    border-radius: 8px;
    margin-bottom: 24px;
  }
  .report-header h1 {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.3px;
    margin-bottom: 10px;
  }
  .header-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
  }
  .pill {
    background: rgba(255,255,255,0.18);
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 20px;
    padding: 3px 12px;
    font-size: 11px;
    color: #fff;
    white-space: nowrap;
  }
  .pill strong { font-weight: 700; }
  .pill.gap-pos { background: #fef3c7; border-color: #fcd34d; color: #92400e; }
  .pill.gap-neg { background: #d1fae5; border-color: #6ee7b7; color: #065f46; }
  .back-link {
    display: inline-block;
    margin-bottom: 12px;
    font-size: 11px;
    color: #4b5563;
    text-decoration: none;
  }
  .back-link:hover { text-decoration: underline; }

  h2 {
    font-size: 15px;
    font-weight: 700;
    color: #1f2937;
    margin: 28px 0 12px;
    padding-bottom: 6px;
    border-bottom: 2px solid #e5e7eb;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  h2 .sec-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px; height: 22px;
    background: #4b5563;
    color: #fff;
    border-radius: 50%;
    font-size: 11px;
    font-weight: 700;
    flex-shrink: 0;
  }
  h3 {
    font-size: 12px;
    font-weight: 600;
    color: #374151;
    margin: 14px 0 6px;
  }

  .card {
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 16px;
  }
  .card-body { padding: 12px 14px; }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 11px;
  }
  thead tr { background: #4b5563; color: #fff; }
  thead th {
    padding: 7px 10px;
    text-align: right;
    font-weight: 600;
    letter-spacing: 0.2px;
    white-space: nowrap;
  }
  thead th.left { text-align: left; }
  tbody tr { border-bottom: 1px solid #f0f0f0; }
  tbody tr:last-child { border-bottom: none; }
  tbody tr:nth-child(even) { background: #f9fafb; }
  tbody td {
    padding: 6px 10px;
    text-align: right;
    color: #374151;
  }
  tbody td.left { text-align: left; }

  td.delta-pos { color: #065f46; }
  td.delta-neg { color: #991b1b; }

  .badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 12px;
    font-size: 10px;
    font-weight: 600;
    vertical-align: middle;
  }
  .badge-green  { background: #d1fae5; color: #065f46; }
  .badge-gray   { background: #f3f4f6; color: #6b7280; }
  .badge-red    { background: #fee2e2; color: #991b1b; }
  .badge-blue   { background: #dbeafe; color: #1e40af; }

  .bar-wrap { display: flex; align-items: center; gap: 6px; }
  .bar-bg {
    flex: 1;
    height: 8px;
    background: #e5e7eb;
    border-radius: 4px;
    overflow: hidden;
  }
  .bar-fill { height: 100%; border-radius: 4px; background: #4b5563; }
  .bar-fill.below { background: #d1d5db; }
  .bar-val { min-width: 36px; text-align: right; font-size: 10px; color: #6b7280; }

  .grid-2 { display: flex; gap: 12px; margin: 8px 0 16px; }
  .grid-2 .chart-box { flex: 1 1 0; min-width: 0; }
  .chart-box { margin: 8px 0 16px; }
  .chart-box img { width: 100%; display: block; border-radius: 6px; border: 1px solid #e5e7eb; }

  .cm-table { width: auto; }
  .cm-table th, .cm-table td { min-width: 70px; text-align: center; }
  .cm-table .cm-tn { background: #d1fae5; color: #065f46; font-weight: 700; }
  .cm-table .cm-tp { background: #d1fae5; color: #065f46; font-weight: 700; }
  .cm-table .cm-fp { background: #fee2e2; color: #991b1b; }
  .cm-table .cm-fn { background: #fee2e2; color: #991b1b; }

  .config-key { color: #6b7280; font-family: monospace; font-size: 10.5px; }
  .config-val { font-family: monospace; font-size: 10.5px; color: #1e2329; }

  .footer {
    margin-top: 28px;
    padding-top: 10px;
    border-top: 1px solid #e5e7eb;
    font-size: 10px;
    color: #9ca3af;
    text-align: center;
  }
</style>
</head>
<body>

<a class="back-link" href="../../report.html">← Main report</a>

<div class="report-header">
  <h1>{{ title }} — {{ model_name }} (sub)</h1>
  <div class="header-pills">
    <span class="pill">🕐 {{ generated_at }}</span>
    <span class="pill">모형 <strong>{{ model_name }}</strong></span>
    <span class="pill">{{ primary_metric }} = <strong>{{ '%.4f'|format(metric_value) }}</strong></span>
    <span class="pill">BEST({{ best_model_name }}) = {{ '%.4f'|format(best_score) }}</span>
    {% set gap = metric_value - best_score %}
    <span class="pill {% if gap >= 0 %}gap-neg{% else %}gap-pos{% endif %}">
      Δ vs best = {{ '%+.4f'|format(gap) }}
    </span>
  </div>
</div>

<!-- ═══ 1. 점수 요약 (본 모형 vs best) ═══ -->
<h2><span class="sec-num">1</span> 점수 요약 (본 모형 vs best)</h2>
<div class="card">
  <table>
    <thead>
      <tr class="group-row">
        <th class="left" rowspan="2">metric</th>
        <th colspan="2">{{ model_name }} (현재)</th>
        <th colspan="2">{{ best_model_name }} (BEST)</th>
        <th rowspan="2">Δ(Test)</th>
      </tr>
      <tr class="sub-row">
        <th>Train</th><th>Test</th>
        <th>Train</th><th>Test</th>
      </tr>
    </thead>
    <tbody>
    {% for m in metric_names %}
      <tr>
        <td class="left">{{ m }}</td>
        <td>{{ '%.4f'|format(this_train[m]) }}</td>
        <td>{{ '%.4f'|format(this_test[m]) }}</td>
        <td>{{ '%.4f'|format(best_train[m]) }}</td>
        <td>{{ '%.4f'|format(best_test[m]) }}</td>
        {% set d = this_test[m] - best_test[m] %}
        <td class="{% if d >= 0 %}delta-pos{% else %}delta-neg{% endif %}">{{ '%+.4f'|format(d) }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</div>

<!-- ═══ 2. Feature Importance ═══ -->
<h2><span class="sec-num">2</span> Feature Importance — {{ model_name }}</h2>
<h3>relative · top {{ top_features }} · 전체 분포는 feature_importance.csv</h3>
<div class="card" style="display: flex; gap: 16px; padding: 12px 14px;">
  <div style="flex: 1;">
    <table style="width: 100%;">
      <thead>
        <tr>
          <th class="left" style="width: 15%;">Rank</th>
          <th class="left" style="width: 55%;">Feature</th>
          <th>Importance</th>
        </tr>
      </thead>
      <tbody>
      {% for row in importance_rows[:15] %}
        <tr>
          <td class="left">{{ loop.index }}</td>
          <td class="left"><strong>{{ row.feature }}</strong></td>
          <td>{{ '%.4f'|format(row.importance_relative) }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  <div style="flex: 1;">
    <table style="width: 100%;">
      <thead>
        <tr>
          <th class="left" style="width: 15%;">Rank</th>
          <th class="left" style="width: 55%;">Feature</th>
          <th>Importance</th>
        </tr>
      </thead>
      <tbody>
      {% for row in importance_rows[15:] %}
        <tr>
          <td class="left">{{ loop.index + 15 }}</td>
          <td class="left"><strong>{{ row.feature }}</strong></td>
          <td>{{ '%.4f'|format(row.importance_relative) }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</div>

<!-- ═══ 3. 모델 상세 (decile / score 분포 / confusion) ═══ -->
<h2><span class="sec-num">3</span> 모델 상세 — {{ model_name }}</h2>

<h3>점수 분포 · 10-분위 차트</h3>
<div class="grid-2">
  <div class="chart-box">
    <h3>Score Distribution by Label</h3>
    <img src="{{ score_dist_chart }}" alt="Score Distribution" />
  </div>
  <div class="chart-box">
    <h3>Decile Analysis Chart</h3>
    <img src="{{ decile_chart }}" alt="Decile Analysis" />
  </div>
</div>

<div class="card">
  <table>
    <thead>
      <tr>
        <th>Decile</th>
        <th>Score Range</th>
        <th>Count</th>
        <th>Target</th>
        <th>Non-Target</th>
        <th>Cum Target</th>
        <th>Cum NonTarget</th>
        <th>Cum Count</th>
        <th>Cum %</th>
        <th>Cum Target Rate</th>
        <th>Cum Non-Target Rate</th>
        <th>Lift</th>
      </tr>
    </thead>
    <tbody>
    {% for r in decile_rows %}
      <tr>
        <td>{{ r.decile }}</td>
        <td>{{ '%.3f'|format(r.score_min) }} ~ {{ '%.3f'|format(r.score_max) }}</td>
        <td>{{ r.count }}</td>
        <td>{{ r.target }}</td>
        <td>{{ r.non_target }}</td>
        <td>{{ r.cum_target }}</td>
        <td>{{ r.cum_nontarget }}</td>
        <td>{{ r.cum_count }}</td>
        <td>{{ '%.1f'|format(r.cum_count_pct * 100) }}%</td>
        <td>{{ '%.4f'|format(r.cum_target_rate) }}</td>
        <td>{{ '%.4f'|format(r.cum_nontarget_rate) }}</td>
        <td><strong>{{ '%.3f'|format(r.lift) }}</strong></td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</div>

<h3>Confusion Matrix &nbsp;<span class="badge badge-gray">threshold = 0.5</span></h3>
<div class="card" style="display:inline-block; margin-bottom:16px;">
  <table class="cm-table">
    <thead>
      <tr><th></th><th>Pred 0</th><th>Pred 1</th></tr>
    </thead>
    <tbody>
      <tr>
        <th style="text-align:left; padding:6px 10px; background:#f9fafb;">True 0</th>
        <td class="cm-tn">{{ confusion[0][0] }}</td>
        <td class="cm-fp">{{ confusion[0][1] }}</td>
      </tr>
      <tr>
        <th style="text-align:left; padding:6px 10px; background:#f9fafb;">True 1</th>
        <td class="cm-fn">{{ confusion[1][0] }}</td>
        <td class="cm-tp">{{ confusion[1][1] }}</td>
      </tr>
    </tbody>
  </table>
</div>

<!-- ═══ 4. 변수 선택 (메인과 동일) ═══ -->
{% if selection %}
<h2><span class="sec-num">4</span> 변수 선택 (Stability Selection)</h2>
<div class="header-pills" style="margin-bottom:12px;">
  <span class="pill" style="background:#f3f4f6; color:#374151; border-color:#d1d5db;">
    base: <strong>{{ selection.base_estimator }}</strong>
  </span>
  <span class="pill" style="background:#f3f4f6; color:#374151; border-color:#d1d5db;">
    부분표본 <strong>{{ selection.n_subsamples }}</strong>회
  </span>
  <span class="pill" style="background:#f3f4f6; color:#374151; border-color:#d1d5db;">
    임계값 <strong>{{ '%.2f'|format(selection.threshold) }}</strong>
  </span>
  <span class="pill" style="background:#d1fae5; color:#065f46; border-color:#6ee7b7;">
    채택 <strong>{{ selection.n_selected }} / {{ selection.n_total }}</strong>
  </span>
  {% if selection.fallback_used %}
  <span class="pill" style="background:#fee2e2; color:#991b1b; border-color:#fca5a5;">
    ⚠ min_selected fallback 발동
  </span>
  {% endif %}
  <span class="pill" style="background:#f3f4f6; color:#6b7280; border-color:#e5e7eb;">
    표 노출 {{ selection.top_n }} / 전체 {{ selection.n_total }}
    (전체 분포는 메인 리포트의 feature_selection.csv)
  </span>
</div>

<div class="card">
  <table>
    <thead>
      <tr>
        <th class="left">Feature</th>
        <th style="width:55%;">Selection Frequency</th>
        <th>채택</th>
      </tr>
    </thead>
    <tbody>
    {% for r in selection.rows %}
      <tr>
        <td class="left">{{ r.feature }}</td>
        <td>
          <div class="bar-wrap">
            <div class="bar-bg">
              <div class="bar-fill {% if not r.selected %}below{% endif %}"
                   style="width: {{ (r.frequency * 100)|round|int }}%;"></div>
            </div>
            <span class="bar-val">{{ '%.1f'|format(r.frequency * 100) }}%</span>
          </div>
        </td>
        <td style="text-align:center;">
          {% if r.selected %}
            <span class="badge badge-green">✓ 채택</span>
          {% else %}
            <span class="badge badge-gray">제외</span>
          {% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}

<!-- ═══ 5. 학습 설정 + 튜닝 (본 모형 한정) ═══ -->
<h2><span class="sec-num">5</span> 학습 설정 + 튜닝 — {{ model_name }}</h2>
<div class="card">
  <table>
    <thead>
      <tr><th class="left">키</th><th class="left">값</th></tr>
    </thead>
    <tbody>
      <tr>
        <td class="left config-key">tuned</td>
        <td class="left config-val">
          {% if tuned %}
            <span class="badge badge-blue">YES</span>
            n_trials = {{ n_trials }}
            {% if best_value is not none %}, best_value = {{ '%.4f'|format(best_value) }}{% endif %}
          {% else %}
            <span class="badge badge-gray">NO</span>
          {% endif %}
        </td>
      </tr>
      {% if avg_best_iter is not none %}
      <tr>
        <td class="left config-key">best_iteration (avg over folds)</td>
        <td class="left config-val">{{ avg_best_iter }}</td>
      </tr>
      {% endif %}
      <tr>
        <td class="left config-key">params (최종)</td>
        <td class="left config-val">{{ params_repr }}</td>
      </tr>
    </tbody>
  </table>
</div>

<div class="footer">
  auto_ml v{{ library_version }} &nbsp;·&nbsp; sub-report &nbsp;·&nbsp; {{ generated_at }}
</div>

</body>
</html>
